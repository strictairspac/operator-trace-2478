COMPOSE_PROJECT_NAME=operator-trace
FRONTEND_PORT=18244
BACKEND_PORT=19244
DB_PORT=17744
JWT_SECRET=operator-trace-local-demo-secret-change-before-use
SEED_DEMO=true
# 执行租约：健康执行按 HEARTBEAT 续租；LEASE 秒未续租即视为失联并允许接管（默认30秒，需小于60秒）。
TRACE_LEASE_SECONDS=30
TRACE_HEARTBEAT_SECONDS=10
TRACE_SWEEP_SECONDS=5
TRACE_REDELIVER_SECONDS=30
WORKER_CONCURRENCY=4
